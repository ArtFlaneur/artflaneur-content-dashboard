# AWS Bedrock credentials for the AI Studio proxy
# The IAM identity needs the bedrock:InvokeModel permission and model access
# enabled for the chosen BEDROCK_MODEL_ID in the target region.

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# Optional — defaults shown
# For newer Claude models use a cross-region inference profile ID (prefix us. or global.)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=8000

# Optional — model used only for storyboard contact sheets.
# Set this to an active text-to-image model enabled in Bedrock for this account and region.
# BEDROCK_IMAGE_MODEL_ID=your_active_text_to_image_model_id

# Optional — only when using temporary STS credentials
# AWS_SESSION_TOKEN=your_session_token
